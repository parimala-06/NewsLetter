# Get this free at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=

# Optional. Gemini's free tier caps out at roughly 20 generateContent
# calls/day (see README). Set this to automatically fall back to Groq's
# free tier (a separate quota) when Gemini's is exhausted. Get a free key at
# https://console.groq.com/keys — no credit card needed. Leave blank to
# disable the fallback (digest requests just fail once Gemini's quota is
# used up).
GROQ_API_KEY=

# Free Supabase project (https://supabase.com) — used for Google sign-in and
# saved/bookmarked topics. Get these from Settings > API in your project.
# Use the PUBLISHABLE / anon key here, never the secret / service_role key —
# this one is exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth Client ID/Secret are NOT set here — they're configured
# directly in the Supabase dashboard under Authentication > Providers >
# Google. Supabase handles the OAuth exchange server-side; this app never
# sees your Google client secret.
